<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>BelzontWE.Tests</RootNamespace>
    <AssemblyName>BelzontWE.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Game DLL resolution: reads CSII_MANAGEDPATH user environment variable -->
    <GameManagedPath Condition="'$(GameManagedPath)' == ''">$(CSII_MANAGEDPATH)</GameManagedPath>
    <_GameDllsAvailable Condition="'$(GameManagedPath)' != '' And Exists('$(GameManagedPath)\UnityEngine.CoreModule.dll')">true</_GameDllsAvailable>
    <DefineConstants Condition="'$(_GameDllsAvailable)' == 'true'">GAME_DLLS_AVAILABLE;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <!-- Metadata-only game assembly references for compilation; not copied to output -->
  <ItemGroup Condition="'$(_GameDllsAvailable)' == 'true'">
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Entities">
      <HintPath>$(GameManagedPath)\Unity.Entities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <HintPath>$(GameManagedPath)\Unity.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(GameManagedPath)\Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="WarnIfGameDllsNotFound" BeforeTargets="BeforeBuild" Condition="'$(_GameDllsAvailable)' != 'true'">
    <Warning Text="Game DLLs not found at '$(GameManagedPath)'. Set CSII_MANAGEDPATH to the game's Managed/ folder. Game-dependent tests will be skipped." />
  </Target>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.4.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp" Version="1.0.16">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Project-to-project reference to the production code under test -->
    <ProjectReference Include="..\BelzontWE\BelzontWE.csproj" />
  </ItemGroup>

</Project>
