# Minimal stub for Cities Skylines II modding SDK (Mod.props).
# Used by the CI workflow when the game is not installed.
# CSII_TOOLPATH must point to the folder containing this file.
<Project>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <!-- ManagedPath left empty; game reference resolution is handled per-project -->
    <ManagedPath Condition="'$(ManagedPath)' == '' And '$(CSII_MANAGEDPATH)' != ''">$(CSII_MANAGEDPATH)</ManagedPath>
  </PropertyGroup>
</Project>
